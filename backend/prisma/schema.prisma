generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  ONLINE_PIX
  ONLINE_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum DeliveryType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum CouponType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

enum OptionPriceMode {
  SUM
  HIGHEST
}

enum UserRole {
  ADMIN
  RESTAURANT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  CANCELED
}

// ─── MODELOS ─────────────────────────────────────────────────────

model User {
  id                Int        @id @default(autoincrement())
  nome              String
  email             String     @unique
  password          String
  createdAt         DateTime   @default(now())
  whatsapp          String?
  slug              String?    @unique
  logo              String?
  banner            String?
  aberto            Boolean    @default(true)
  horarioAbertura   String?
  horarioFechamento String?
  corPrimaria       String?    @default("#16a34a")
  taxaEntrega       Float      @default(0)
  role              UserRole   @default(RESTAURANT)
  isActive          Boolean    @default(true)
  plan              String     @default("FREE")
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt       DateTime?
  asaasCustomerId   String?
  asaasSubscriptionId String?
  gtmId             String?
  ga4MeasurementId  String?
  metaPixelId       String?
  metaAccessToken   String?
  customDomain      String?    @unique
  customDomainVerified Boolean @default(false)
  customDomainStatus String?   @default("PENDING")

  resetToken        String?
  resetTokenExpiry  DateTime?

  categories        Category[]
  products          Product[]
  orders            Order[]
  coupons           Coupon[]
  customers         Customer[]
}

model Category {
  id           Int       @id @default(autoincrement())
  nome         String
  displayOrder Int       @default(0)

  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  products     Product[]
}

model Product {
  id           Int       @id @default(autoincrement())
  nome         String
  descricao    String?
  preco        Float
  imagem       String?
  disponivel   Boolean   @default(true)
  displayOrder Int       @default(0)

  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  optionGroups OptionGroup[]
  orderItems   OrderItem[]
}

model OptionGroup {
  id             Int             @id @default(autoincrement())
  productId      Int
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  nome           String
  minSelections  Int             @default(0)
  maxSelections  Int             @default(1)
  priceMode      OptionPriceMode @default(SUM)
  required       Boolean         @default(false)
  displayOrder   Int             @default(0)
  options        Option[]
  createdAt      DateTime        @default(now())
}

model Option {
  id              Int         @id @default(autoincrement())
  optionGroupId   Int
  optionGroup     OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  nome            String
  priceModifier   Float       @default(0)
  available       Boolean     @default(true)
  displayOrder    Int         @default(0)
}

model Order {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId        Int?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderNumber       Int

  customerName      String
  customerPhone     String
  customerAddress   Json?

  deliveryType      DeliveryType  @default(DELIVERY)
  deliveryFee       Float         @default(0)
  subtotal          Float
  discountAmount    Float         @default(0)
  total             Float

  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  orderStatus       OrderStatus   @default(PENDING)

  notes             String?
  couponId          Int?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  couponCode        String?

  externalPaymentId String?
  pixQrCode         String?
  pixCopyPaste      String?
  paidAt            DateTime?

  items             OrderItem[]
  history           OrderStatusHistory[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  confirmedAt       DateTime?
  deliveredAt       DateTime?
  canceledAt        DateTime?

  @@unique([userId, orderNumber])
  @@index([userId, orderStatus])
  @@index([userId, createdAt])
  @@index([customerId])
}

model Customer {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  document    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastOrderAt DateTime?

  orders      Order[]

  @@unique([userId, phone])
  @@index([userId, name])
  @@index([userId, lastOrderAt])
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            Int?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  productPriceSnapshot Float
  quantity             Int
  unitPrice            Float
  selectedOptions      Json?
  itemNotes            String?
  itemTotal            Float
}

model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  createdAt  DateTime     @default(now())
}

model Coupon {
  id                Int        @id @default(autoincrement())
  userId            Int
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code              String
  type              CouponType
  value             Float
  minOrderValue     Float?
  maxDiscountAmount Float?
  maxUses           Int?
  usedCount         Int        @default(0)
  validFrom         DateTime   @default(now())
  validUntil        DateTime?
  active            Boolean    @default(true)
  orders            Order[]
  createdAt         DateTime   @default(now())

  @@unique([userId, code])
  @@index([userId, active])
}
