generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  ONLINE_PIX
  ONLINE_CARD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum DeliveryType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum CouponType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

enum OptionPriceMode {
  SUM
  HIGHEST
  FIXED_TOTAL
}

enum OptionGroupTipo {
  COMPLEMENTO
  OPCAO
  ADICIONAL
  VARIACAO
}

enum TabStatus {
  OPEN
  CLOSED
  CANCELED
}

enum TabTipo {
  SALAO
  DELIVERY
  RETIRADA
  BALCAO
}

// Enum separado de PaymentMethod (Order inline) — será o único após Fase E
enum TabPaymentMethod {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  FIADO
}

// Status de Payment dedicado (CONFIRMED ao invés de PAID do enum legado)
enum TabPaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum OrderOrigin {
  WEBSITE
  MANUAL
  WHATSAPP_BOT
  IFOOD
  OTHER
}

// ─── ETAPA 3: DELIVERY + MARKETPLACE ─────────────────────────

enum ZoneType {
  BAIRRO_LIST
  RADIUS
  // POLYGON  // futuro
}

enum DeliveryAttemptStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
  RETRY_SCHEDULED
  CANCELED
}

enum MarketplaceProvider {
  IFOOD
  NINETYNINEFOOD
  KEETA
}

// ─── ETAPA 5: CAIXA + FIADO ──────────────────────────────────

enum CashRegisterSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  ENTRADA
  SAIDA
}

enum CashMovementOrigin {
  PAYMENT_CASH
  FIADO_QUITACAO
  MANUAL_SUPRIMENTO
  MANUAL_SANGRIA
}

enum FiadoTransactionType {
  DEBITO
  CREDITO
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  CANCELED
}

enum PromoDiscountType {
  PERCENTUAL
  VALOR_FIXO
  PRECO_FIXO
}

// ─── ETAPA 9: CAMPAIGNS ──────────────────────────────────────────

enum CampaignTipo {
  CUPOM_UNICO
  CUPOM_GENERICO
  MENSAGEM
}

enum CampaignChannel {
  WHATSAPP
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELED
  FAILED
}

enum AgendamentoTipo {
  IMMEDIATE
  SCHEDULED
  RECURRING
  TRIGGER
}

enum DispatchStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CONVERTED
}

// ─── MODELOS ─────────────────────────────────────────────────────

model Category {
  id           Int        @id @default(autoincrement())
  nome         String
  displayOrder Int        @default(0)
  ativa        Boolean    @default(true)
  icone        String?

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  products     Product[]
}

model Product {
  id               Int     @id @default(autoincrement())
  nome             String
  descricao        String?
  preco            Float
  imagem           String?
  disponivel       Boolean @default(true)
  displayOrder     Int     @default(0)
  precoPromocional Float?
  tempoPreparo     Int?
  sku              String?
  emDestaque       Boolean @default(false)
  estoqueAtivo     Boolean @default(false)
  estoque          Int     @default(0)

  disponibilidadeAtiva  Boolean @default(false)
  disponibilidadeInicio String?
  disponibilidadeFim    String?

  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  productionSectorId Int?
  productionSector   ProductionSector? @relation(fields: [productionSectorId], references: [id])

  optionGroups       ProductComplement[]
  orderItems         OrderItem[]
  comboItems         ComboItem[]
  availabilities     ProductAvailability[]

  @@index([productionSectorId])
}

model OptionGroup {
  id            Int             @id @default(autoincrement())
  restaurantId  Int
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  tipo          OptionGroupTipo @default(ADICIONAL)
  minSelections Int             @default(0)
  maxSelections Int             @default(1)
  priceMode     OptionPriceMode @default(SUM)
  required      Boolean         @default(false)
  ativo         Boolean         @default(true)
  displayOrder  Int             @default(0)
  productLinks  ProductComplement[]
  options       Option[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([restaurantId, ativo])
}

model Option {
  id            Int         @id @default(autoincrement())
  optionGroupId Int
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  nome          String
  descricao     String?
  priceModifier Float       @default(0)
  imagem        String?
  available     Boolean     @default(true)
  estoque       Int?
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ProductComplement {
  productId     Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroupId Int
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  ordem         Int         @default(0)

  @@id([productId, optionGroupId])
  @@index([optionGroupId])
}

model ProductAvailability {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())

  @@unique([productId, dayOfWeek, startTime, endTime])
  @@index([productId, dayOfWeek])
}

model Order {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   Int?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderNumber  Int

  customerName    String
  customerPhone   String
  customerAddress Json?

  deliveryType   DeliveryType  @default(DELIVERY)
  deliveryFee    Float         @default(0)
  subtotal       Float
  discountAmount Float         @default(0)
  total          Float

  orderStatus   OrderStatus   @default(PENDING)

  notes       String?
  couponId    Int?
  coupon      Coupon?  @relation(fields: [couponId], references: [id])
  couponCode  String?

  origin          OrderOrigin @default(WEBSITE)
  externalOrderId String?
  externalChannel String?

  marketplaceIntegrationId Int?
  marketplaceIntegration   MarketplaceIntegration? @relation(fields: [marketplaceIntegrationId], references: [id], onDelete: SetNull)

  tabId   Int?
  tab     Tab? @relation(fields: [tabId], references: [id])

  items            OrderItem[]
  history          OrderStatusHistory[]
  deliveryAttempts DeliveryAttempt[]
  campaignMessages CampaignMessage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  confirmedAt DateTime?
  deliveredAt DateTime?
  canceledAt  DateTime?

  loyaltyPointsEarned Int?
  loyaltyPointsUsed   Int?
  npsRequested        Boolean @default(false)

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, orderStatus])
  @@index([restaurantId, createdAt])
  @@index([customerId])
  @@index([restaurantId, origin])
  @@index([tabId])
  @@index([externalOrderId])
}

model Customer {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  document     String?
  tags         String[]   @default([])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastOrderAt  DateTime?

  fiadoLimite Decimal @default(0) @db.Decimal(10, 2)
  fiadoTotal  Decimal @default(0) @db.Decimal(10, 2)

  totalSpent   Decimal   @default(0) @db.Decimal(10, 2)
  firstOrderAt DateTime?

  orders       Order[]
  tabs         Tab[]

  auth          CustomerAuth?
  loyaltyPoints LoyaltyPoints[]
  loyaltyTx     LoyaltyTransaction[]
  npsResponses  NpsResponse[]
  fiadoTransactions FiadoTransaction[]
  campaignMessages  CampaignMessage[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, name])
  @@index([restaurantId, lastOrderAt])
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            Int?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  productPriceSnapshot Float
  quantity             Int
  unitPrice            Float
  selectedOptions      Json?
  itemNotes            String?
  itemTotal            Float

  precoOriginal        Float?
  appliedPromotionId   Int?
  appliedPromotion     PromotionalSchedule? @relation(fields: [appliedPromotionId], references: [id], onDelete: SetNull)
}

model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  createdAt  DateTime     @default(now())
}

model Coupon {
  id                Int        @id @default(autoincrement())
  restaurantId      Int
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  code              String
  type              CouponType
  value             Float
  minOrderValue     Float?
  maxDiscountAmount Float?
  maxUses           Int?
  usedCount         Int        @default(0)
  limitePorCliente  Int?
  validFrom         DateTime   @default(now())
  validUntil        DateTime?
  active            Boolean    @default(true)
  orders            Order[]
  campaigns         Campaign[]
  campaignMessages  CampaignMessage[]
  createdAt         DateTime   @default(now())

  @@unique([restaurantId, code])
  @@index([restaurantId, active])
}

model CustomerAuth {
  id           Int        @id @default(autoincrement())
  customerId   Int        @unique
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone        String
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  pin          String?
  pinExpiry    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model LoyaltyPoints {
  id           Int        @id @default(autoincrement())
  customerId   Int
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  points       Int        @default(0)
  totalEarned  Int        @default(0)
  totalSpent   Int        @default(0)
  updatedAt    DateTime   @updatedAt

  @@unique([customerId, restaurantId])
}

model LoyaltyTransaction {
  id           Int        @id @default(autoincrement())
  customerId   Int
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      Int?
  type         String
  points       Int
  description  String?
  createdAt    DateTime   @default(now())
}

model NpsResponse {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customerId   Int?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId      Int?
  score        Int
  comment      String?
  reply        String?
  repliedAt    DateTime?
  createdAt    DateTime   @default(now())
}

model CartAbandonment {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  phone        String?
  cartData     Json
  notified     Boolean    @default(false)
  notifiedAt   DateTime?
  createdAt    DateTime   @default(now())
}

model Table {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  numero       Int
  nome         String?
  capacidade   Int        @default(4)
  ativa        Boolean    @default(true)
  qrCode       String?
  tabs         Tab[]
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, numero])
}

model Combo {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  nome         String
  descricao    String?
  preco        Float
  ativo        Boolean    @default(true)
  imagem       String?
  items        ComboItem[]
  createdAt    DateTime   @default(now())
}

model ComboItem {
  id         Int     @id @default(autoincrement())
  comboId    Int
  combo      Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantidade Int     @default(1)
}

model AuditLog {
  id           Int        @id @default(autoincrement())
  accountId    Int?
  account      Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  action       String
  entity       String
  entityId     Int?
  meta         Json?
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// ─── TENANCY REFACTOR — Etapa 0 ─────────────────────────────

enum MembershipRole {
  OWNER
  MANAGER
  ATTENDANT
  KITCHEN
  CASHIER
}

model Account {
  id               Int          @id @default(autoincrement())
  publicId         String       @unique @default(uuid(7))
  email            String       @unique
  password         String
  nome             String
  whatsapp         String?
  isActive         Boolean      @default(true)
  isPlatformAdmin  Boolean      @default(false)
  asaasCustomerId  String?
  resetToken       String?
  resetTokenExpiry DateTime?
  memberships      Membership[]
  auditLogs        AuditLog[]
  openedSessions   CashRegisterSession[] @relation("OpenedSessions")
  closedSessions   CashRegisterSession[] @relation("ClosedSessions")
  cashMovements    CashMovement[]
  fiadoTransactions FiadoTransaction[]
  audiencesCreated  Audience[]  @relation("AudienceCreator")
  campaignsCreated  Campaign[]  @relation("CampaignCreator")
  createdAt         DateTime    @default(now())
  updatedAt        DateTime     @updatedAt
}

model Restaurant {
  id       Int    @id @default(autoincrement())
  publicId String @unique @default(uuid(7))
  slug     String @unique
  nome     String

  // Branding
  logo            String?
  banner          String?
  corPrimaria     String? @default("#16a34a")
  textoBoasVindas String?
  textoRodape     String?
  mostrarPrecos   Boolean @default(true)

  // Status
  aberto          Boolean @default(true)
  pausaAtiva      Boolean @default(false)
  pausaAbertura   String?
  pausaFechamento String?
  mensagemFechado String?

  // Horários
  horarioAbertura   String?
  horarioFechamento String?
  businessHours     Json?

  // Modalidades + entrega
  aceitaEntrega             Boolean @default(true)
  aceitaRetirada            Boolean @default(true)
  aceitaMesa                Boolean @default(false)
  taxaEntrega               Float   @default(0)
  tempoEstimadoEntrega      String?
  pedidoMinimoEntregaGratis Float?
  raioEntregaKm             Float?
  bairrosAtendidos          Json?
  mensagemEntrega           String?

  // Pagamentos presenciais
  aceitaDinheiro      Boolean @default(true)
  aceitaPixPresencial Boolean @default(true)
  aceitaCartaoCredito Boolean @default(true)
  aceitaCartaoDebito  Boolean @default(true)
  chavePix            String?

  // Contato
  whatsapp String?

  // WhatsApp messages
  wppMsgPedido       String?
  wppMsgConfirmado   String?
  wppMsgPronto       String?
  wppMsgSaiu         String?
  wppEnvioAutomatico Boolean @default(false)

  // White-label
  nomePlataforma  String?
  emailSuporte    String?
  whatsappSuporte String?
  urlPublica      String?

  // Subscription
  plan                String             @default("FREE")
  subscriptionStatus  SubscriptionStatus @default(TRIAL)
  trialEndsAt         DateTime?
  asaasSubscriptionId String?

  // Tracking
  gtmId            String?
  ga4MeasurementId String?
  metaPixelId      String?
  metaAccessToken  String?

  // Custom domain
  customDomain         String?  @unique
  customDomainVerified Boolean  @default(false)
  customDomainStatus   String?  @default("PENDING")

  // Loyalty
  loyaltyEnabled      Boolean @default(false)
  loyaltyPointsPerBrl Float   @default(1)
  loyaltyRedeemRate   Float   @default(100)

  // NPS
  npsEnabled        Boolean @default(true)
  npsDaysAfterOrder Int     @default(1)

  // Notifications
  notifEmailNewOrder Boolean @default(false)

  // Localização
  lat Float?
  lng Float?
  cep String?

  // Inverse relations
  categories        Category[]
  products          Product[]
  productionSectors ProductionSector[]
  promotions       PromotionalSchedule[]
  optionGroups     OptionGroup[]
  orders           Order[]
  coupons          Coupon[]
  customers        Customer[]
  customerAuths    CustomerAuth[]
  tables           Table[]
  combos           Combo[]
  auditLogs        AuditLog[]
  loyaltyPoints    LoyaltyPoints[]
  loyaltyTx        LoyaltyTransaction[]
  npsResponses     NpsResponse[]
  cartAbandonments CartAbandonment[]

  tabs         Tab[]
  tabPayments  Payment[]
  memberships  Membership[]

  deliveryZones           DeliveryZone[]
  deliveryAttempts        DeliveryAttempt[]
  marketplaceIntegrations MarketplaceIntegration[]
  cashRegisterSessions    CashRegisterSession[]
  cashMovements           CashMovement[]
  fiadoTransactions       FiadoTransaction[]
  audiences               Audience[]
  campaigns               Campaign[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([slug])
  @@index([customDomain])
}

model ProductionSector {
  id           Int        @id @default(autoincrement())
  publicId     String     @unique @default(uuid(7))
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  nome         String
  cor          String?
  ordem        Int        @default(0)
  ativo        Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products     Product[]

  @@unique([restaurantId, nome])
  @@index([restaurantId, ativo])
}

model PromotionalSchedule {
  id           Int               @id @default(autoincrement())
  publicId     String            @unique @default(uuid(7))
  restaurantId Int
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  nome         String
  descricao    String?

  productIds   Int[]             @default([])
  categoryIds  Int[]             @default([])

  tipoDesconto PromoDiscountType
  valorDesconto Float

  validoDe     DateTime?
  validoAte    DateTime?
  diasSemana   Int[]             @default([])
  horaInicio   String?
  horaFim      String?

  ativo        Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  appliedTo    OrderItem[]

  @@index([restaurantId, ativo])
}

model Membership {
  id           Int            @id @default(autoincrement())
  accountId    Int
  account      Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  restaurantId Int
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role         MembershipRole @default(OWNER)
  ativo        Boolean        @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([accountId, restaurantId])
  @@index([restaurantId, ativo])
  @@index([accountId, ativo])
}

// ─── ETAPA 2: TAB + PAYMENT ───────────────────────────────────

model Tab {
  id           Int        @id @default(autoincrement())
  publicId     String     @unique @default(uuid(7))
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId             Int?
  table               Table?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  numeroComandaFisica String?
  customerId          Int?
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerNome        String?

  status            TabStatus @default(OPEN)
  tipo              TabTipo
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  openedByAccountId Int?
  closedByAccountId Int?

  descontoManualValor  Decimal? @db.Decimal(10, 2)
  descontoManualMotivo String?
  descontoManualPor    Int?
  taxaServico          Decimal? @db.Decimal(10, 2)

  subtotal  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @default(0) @db.Decimal(10, 2)
  totalPago Decimal @default(0) @db.Decimal(10, 2)

  orders            Order[]
  payments          Payment[]
  deliveryAttempts  DeliveryAttempt[]
  fiadoTransactions FiadoTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([tableId])
  @@index([numeroComandaFisica])
}

model Payment {
  id           Int        @id @default(autoincrement())
  publicId     String     @unique @default(uuid(7))
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tabId Int?
  tab   Tab? @relation(fields: [tabId], references: [id], onDelete: Cascade)

  metodo  TabPaymentMethod
  valor   Decimal          @db.Decimal(10, 2)
  trocoEm Decimal?         @db.Decimal(10, 2)
  status  TabPaymentStatus @default(PENDING)

  pixTransactionId String?
  pixEndToEndId    String?

  cardLast4 String?
  cardBrand String?

  appliesToOrderItemIds Int[] @default([])

  recebidoPor Int?
  recebidoEm  DateTime?
  observacao  String?

  cashRegisterSessionId Int?
  cashRegisterSession   CashRegisterSession? @relation(fields: [cashRegisterSessionId], references: [id], onDelete: SetNull)

  cashMovements     CashMovement[]
  fiadoTransactions FiadoTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tabId])
  @@index([restaurantId, status])
  @@index([cashRegisterSessionId])
}

// ─── ETAPA 3: DELIVERY ZONES ─────────────────────────────────

model DeliveryZone {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  tipo         ZoneType

  bairros   String[] @default([])

  centerLat Float?
  centerLng Float?
  radiusKm  Float?

  fretefixo        Decimal @db.Decimal(10, 2)
  tempoEstimadoMin Int
  prioridade       Int     @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, isActive])
  @@index([restaurantId, tipo])
}

// ─── ETAPA 3: DELIVERY ATTEMPTS ──────────────────────────────

model DeliveryAttempt {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId      Int
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tabId        Int?
  tab          Tab?       @relation(fields: [tabId], references: [id], onDelete: SetNull)

  status        DeliveryAttemptStatus @default(PENDING)
  attemptNumber Int

  assignedTo    String?
  failureReason String?
  observacao    String?

  startedAt   DateTime?
  completedAt DateTime?

  createdByAccountId Int?
  updatedByAccountId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, attemptNumber])
  @@index([restaurantId, status])
  @@index([orderId])
  @@index([tabId])
}

// ─── ETAPA 3: MARKETPLACE INTEGRATION ────────────────────────

model MarketplaceIntegration {
  id           Int                 @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  marketplace        MarketplaceProvider
  externalMerchantId String

  isActive Boolean @default(false)

  authData   String?
  config     Json    @default("{}")

  lastSyncAt DateTime?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, marketplace])
  @@index([marketplace, isActive])
}

// ─── ETAPA 5: CAIXA + FIADO ──────────────────────────────────

model CashRegisterSession {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  openedByAccountId Int
  openedBy          Account  @relation("OpenedSessions", fields: [openedByAccountId], references: [id], onDelete: Restrict)

  closedByAccountId Int?
  closedBy          Account? @relation("ClosedSessions", fields: [closedByAccountId], references: [id], onDelete: SetNull)

  name   String?
  status CashRegisterSessionStatus @default(OPEN)

  valorInicial  Decimal  @db.Decimal(10, 2)
  valorEsperado Decimal? @db.Decimal(10, 2)
  valorContado  Decimal? @db.Decimal(10, 2)
  diferenca     Decimal? @db.Decimal(10, 2)

  observacaoAbertura   String?
  observacaoFechamento String?

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  payments      Payment[]
  cashMovements CashMovement[]

  @@index([restaurantId, status])
  @@index([restaurantId, openedByAccountId])
}

model CashMovement {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  cashRegisterSessionId Int
  cashRegisterSession   CashRegisterSession @relation(fields: [cashRegisterSessionId], references: [id], onDelete: Cascade)

  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdByAccountId Int
  createdBy          Account @relation(fields: [createdByAccountId], references: [id], onDelete: Restrict)

  tipo      CashMovementType
  origem    CashMovementOrigin
  valor     Decimal            @db.Decimal(10, 2)
  descricao String?
  observacao String?

  createdAt DateTime @default(now())

  @@index([cashRegisterSessionId])
  @@index([restaurantId])
  @@index([paymentId])
}

model FiadoTransaction {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  tabId Int?
  tab   Tab? @relation(fields: [tabId], references: [id], onDelete: SetNull)

  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdByAccountId Int
  createdBy          Account @relation(fields: [createdByAccountId], references: [id], onDelete: Restrict)

  tipo               FiadoTransactionType
  valor              Decimal              @db.Decimal(10, 2)
  saldoAposTransacao Decimal              @db.Decimal(10, 2)
  observacao         String?

  createdAt DateTime @default(now())

  @@index([restaurantId, customerId])
  @@index([customerId])
  @@index([tabId])
  @@index([paymentId])
}

model Audience {
  id             Int       @id @default(autoincrement())
  restaurantId   Int
  nome           String
  descricao      String?
  filtros        Json
  estimatedSize  Int       @default(0)
  lastEstimateAt DateTime?

  createdByAccountId Int
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy  Account    @relation("AudienceCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)

  campaigns Campaign[]

  @@index([restaurantId, deletedAt])
  @@index([createdByAccountId])
}

model Campaign {
  id           Int             @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  nome         String
  descricao    String?
  tipo         CampaignTipo
  channel      CampaignChannel @default(WHATSAPP)
  status       CampaignStatus  @default(DRAFT)

  agendamentoTipo AgendamentoTipo @default(IMMEDIATE)
  scheduledAt     DateTime?
  recurringCron   String?    // cron expression
  recurringEndsAt DateTime?  // data final da recorrência
  // TODO: lastRunAt deriva de MAX(CampaignDispatch.completedAt) — sem coluna
  //       dedicada. Implementar query helper em CampaignsService quando precisar.

  // audienceId é nullable porque triggers automáticos (Fase F) criam Campaigns
  // sem Audience persistida — recipient gerado dinamicamente.
  audienceId Int?
  audience   Audience? @relation(fields: [audienceId], references: [id], onDelete: Restrict)

  couponId Int?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  templateBody String

  // Denormalização intencional: stats rápidos sem agregar dispatches
  statsTotal     Int @default(0)
  statsSent      Int @default(0)
  statsFailed    Int @default(0)
  statsDelivered Int @default(0)
  statsRead      Int @default(0)
  statsConverted Int @default(0)

  createdByAccountId Int
  createdBy          Account @relation("CampaignCreator", fields: [createdByAccountId], references: [id], onDelete: Restrict)

  dispatches CampaignDispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([audienceId])
  @@index([createdByAccountId])
  @@index([couponId])
}

model CampaignDispatch {
  id         Int      @id @default(autoincrement())
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  status         DispatchStatus @default(SCHEDULED)
  totalMessages  Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  deliveredCount Int            @default(0)
  readCount      Int            @default(0)

  scheduledAt  DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?

  messages CampaignMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, status])
  @@index([scheduledAt])
}

model CampaignMessage {
  id         Int              @id @default(autoincrement())
  dispatchId Int
  dispatch   CampaignDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  customerId Int
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  couponId Int?
  coupon   Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)

  orderId Int?
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  status       MessageStatus @default(PENDING)
  phone        String
  renderedBody String

  zapiMessageId String?

  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  convertedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatchId, status])
  @@index([customerId])
  @@index([couponId])
  @@index([zapiMessageId])
  @@index([orderId])
}
