generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  ONLINE_PIX
  ONLINE_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum DeliveryType {
  DELIVERY
  PICKUP
  DINE_IN
}

enum CouponType {
  PERCENT
  FIXED
  FREE_DELIVERY
}

enum OptionPriceMode {
  SUM
  HIGHEST
}

enum ComandaStatus {
  ABERTA
  FECHADA
  CANCELADA
}

enum AgendamentoTipo {
  PEDIDO
  RESERVA
  ENCOMENDA
}

enum AgendamentoStatus {
  PENDENTE
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

enum CampaignTipo {
  CUPOM
  LINK
  RETORNO
}

enum CampaignStatus {
  RASCUNHO
  ATIVA
  PAUSADA
  ENCERRADA
}

enum OrderOrigin {
  WEBSITE
  MANUAL
  WHATSAPP_BOT
  IFOOD
  RAPPI_99
  UBER_EATS
  OTHER
}

enum UserRole {
  ADMIN
  RESTAURANT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  OVERDUE
  CANCELED
}

// ─── MODELOS ─────────────────────────────────────────────────────

model User {
  id                Int        @id @default(autoincrement())
  nome              String
  email             String     @unique
  password          String
  createdAt         DateTime   @default(now())
  whatsapp          String?
  slug              String?    @unique
  logo              String?
  banner            String?
  aberto            Boolean    @default(true)
  horarioAbertura   String?
  horarioFechamento String?
  corPrimaria       String?    @default("#16a34a")
  taxaEntrega       Float      @default(0)

  // Entrega
  aceitaEntrega              Boolean  @default(true)
  aceitaRetirada             Boolean  @default(true)
  aceitaMesa                 Boolean  @default(false)
  tempoEstimadoEntrega       String?
  pedidoMinimoEntregaGratis  Float?
  raioEntregaKm              Float?

  // Pagamentos presenciais
  aceitaDinheiro             Boolean  @default(true)
  aceitaPixPresencial        Boolean  @default(true)
  aceitaCartaoCredito        Boolean  @default(true)
  aceitaCartaoDebito         Boolean  @default(true)
  chavePix                   String?

  // Horários por dia
  businessHours              Json?

  // Aparência do cardápio
  textoBoasVindas            String?
  textoRodape                String?
  mostrarPrecos              Boolean  @default(true)
  mensagemFechado            String?
  pausaAtiva                 Boolean  @default(false)
  pausaAbertura              String?
  pausaFechamento            String?
  bairrosAtendidos           Json?
  mensagemEntrega            String?
  wppMsgPedido               String?
  wppMsgConfirmado           String?
  wppMsgPronto               String?
  wppMsgSaiu                 String?
  wppEnvioAutomatico         Boolean  @default(false)
  nomePlataforma             String?
  emailSuporte               String?
  whatsappSuporte            String?
  urlPublica                 String?

  role              UserRole   @default(RESTAURANT)
  isActive          Boolean    @default(true)
  plan              String     @default("FREE")
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  trialEndsAt       DateTime?
  asaasCustomerId   String?
  asaasSubscriptionId String?
  gtmId             String?
  ga4MeasurementId  String?
  metaPixelId       String?
  metaAccessToken   String?
  customDomain      String?    @unique
  customDomainVerified Boolean @default(false)
  customDomainStatus String?   @default("PENDING")

  resetToken        String?
  resetTokenExpiry  DateTime?

  categories        Category[]
  products          Product[]
  orders            Order[]
  coupons           Coupon[]
  customers         Customer[]
  tables            Table[]
  agendamentos      Agendamento[]
  combos            Combo[]
  campaigns         Campaign[]
  auditLogs         AuditLog[]

  loyaltyEnabled      Boolean  @default(false)
  loyaltyPointsPerBrl Float    @default(1)
  loyaltyRedeemRate   Float    @default(100)
  npsEnabled          Boolean  @default(true)
  npsDaysAfterOrder   Int      @default(1)

  notifEmailNewOrder  Boolean  @default(false)
}

model Category {
  id           Int       @id @default(autoincrement())
  nome         String
  displayOrder Int       @default(0)
  ativa        Boolean   @default(true)
  icone        String?

  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  products     Product[]
}

model Product {
  id           Int       @id @default(autoincrement())
  nome         String
  descricao    String?
  preco        Float
  imagem       String?
  disponivel   Boolean   @default(true)
  displayOrder Int       @default(0)
  precoPromocional Float?
  tempoPreparo Int?
  sku          String?
  emDestaque   Boolean   @default(false)
  estoqueAtivo Boolean   @default(false)
  estoque      Int       @default(0)

  disponibilidadeAtiva Boolean @default(false)
  disponibilidadeInicio String?
  disponibilidadeFim    String?
  disponibilidadeDias   Int[]   @default([0,1,2,3,4,5,6])

  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  optionGroups OptionGroup[]
  orderItems   OrderItem[]
  comboItems   ComboItem[]
  comandaItems ComandaItem[]
}

model OptionGroup {
  id             Int             @id @default(autoincrement())
  productId      Int
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  nome           String
  minSelections  Int             @default(0)
  maxSelections  Int             @default(1)
  priceMode      OptionPriceMode @default(SUM)
  required       Boolean         @default(false)
  displayOrder   Int             @default(0)
  options        Option[]
  createdAt      DateTime        @default(now())
}

model Option {
  id              Int         @id @default(autoincrement())
  optionGroupId   Int
  optionGroup     OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  nome            String
  priceModifier   Float       @default(0)
  available       Boolean     @default(true)
  displayOrder    Int         @default(0)
}

model Order {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId        Int?
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderNumber       Int

  customerName      String
  customerPhone     String
  customerAddress   Json?

  deliveryType      DeliveryType  @default(DELIVERY)
  deliveryFee       Float         @default(0)
  subtotal          Float
  discountAmount    Float         @default(0)
  total             Float

  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  orderStatus       OrderStatus   @default(PENDING)

  notes             String?
  couponId          Int?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  couponCode        String?

  externalPaymentId String?
  pixQrCode         String?
  pixCopyPaste      String?
  paidAt            DateTime?

  origin            OrderOrigin   @default(WEBSITE)
  externalOrderId   String?
  externalChannel   String?

  items             OrderItem[]
  history           OrderStatusHistory[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  confirmedAt       DateTime?
  deliveredAt       DateTime?
  canceledAt        DateTime?

  loyaltyPointsEarned Int?
  loyaltyPointsUsed   Int?
  npsRequested        Boolean @default(false)

  @@unique([userId, orderNumber])
  @@index([userId, orderStatus])
  @@index([userId, createdAt])
  @@index([customerId])
  @@index([userId, origin])
}

model Customer {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String
  document    String?
  tags        String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastOrderAt DateTime?

  orders       Order[]
  agendamentos Agendamento[]

  auth           CustomerAuth?
  loyaltyPoints  LoyaltyPoints[]
  loyaltyTx      LoyaltyTransaction[]
  npsResponses   NpsResponse[]

  @@unique([userId, phone])
  @@index([userId, name])
  @@index([userId, lastOrderAt])
}

model OrderItem {
  id                   Int      @id @default(autoincrement())
  orderId              Int
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            Int?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot  String
  productPriceSnapshot Float
  quantity             Int
  unitPrice            Float
  selectedOptions      Json?
  itemNotes            String?
  itemTotal            Float
}

model OrderStatusHistory {
  id         Int          @id @default(autoincrement())
  orderId    Int
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  createdAt  DateTime     @default(now())
}

model Coupon {
  id                Int        @id @default(autoincrement())
  userId            Int
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code              String
  type              CouponType
  value             Float
  minOrderValue     Float?
  maxDiscountAmount Float?
  maxUses           Int?
  usedCount         Int        @default(0)
  limitePorCliente  Int?
  validFrom         DateTime   @default(now())
  validUntil        DateTime?
  active            Boolean    @default(true)
  orders            Order[]
  campaigns         Campaign[]
  createdAt         DateTime   @default(now())

  @@unique([userId, code])
  @@index([userId, active])
}

model CustomerAuth {
  id         Int       @id @default(autoincrement())
  customerId Int       @unique
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  userId     Int
  pin        String?
  pinExpiry  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model LoyaltyPoints {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId      Int
  points      Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  updatedAt   DateTime @updatedAt
  @@unique([customerId, userId])
}

model LoyaltyTransaction {
  id          Int      @id @default(autoincrement())
  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId      Int
  orderId     Int?
  type        String
  points      Int
  description String?
  createdAt   DateTime @default(now())
}

model NpsResponse {
  id         Int       @id @default(autoincrement())
  userId     Int
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId    Int?
  score      Int
  comment    String?
  reply      String?
  repliedAt  DateTime?
  createdAt  DateTime  @default(now())
}

model CartAbandonment {
  id         Int       @id @default(autoincrement())
  userId     Int
  phone      String?
  cartData   Json
  notified   Boolean   @default(false)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Table {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  numero     Int
  nome       String?
  capacidade Int       @default(4)
  ativa      Boolean   @default(true)
  qrCode     String?
  comandas   Comanda[]
  createdAt  DateTime  @default(now())

  @@unique([userId, numero])
}

model Comanda {
  id        Int           @id @default(autoincrement())
  tableId   Int
  table     Table         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId    Int
  status    ComandaStatus @default(ABERTA)
  total     Float         @default(0)
  items     ComandaItem[]
  createdAt DateTime      @default(now())
  closedAt  DateTime?
}

model ComandaItem {
  id         Int     @id @default(autoincrement())
  comandaId  Int
  comanda    Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantidade Int
  preco      Float
  obs        String?
}

model Agendamento {
  id          Int               @id @default(autoincrement())
  userId      Int
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  Int?
  customer    Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tipo        AgendamentoTipo   @default(PEDIDO)
  status      AgendamentoStatus @default(PENDENTE)
  dataHora    DateTime
  descricao   String?
  total       Float?
  obs         String?
  createdAt   DateTime          @default(now())
}

model Combo {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  descricao String?
  preco     Float
  ativo     Boolean     @default(true)
  imagem    String?
  items     ComboItem[]
  createdAt DateTime    @default(now())
}

model ComboItem {
  id         Int     @id @default(autoincrement())
  comboId    Int
  combo      Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantidade Int     @default(1)
}

model Campaign {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome            String
  tipo            CampaignTipo   @default(CUPOM)
  status          CampaignStatus @default(RASCUNHO)
  couponId        Int?
  coupon          Coupon?        @relation(fields: [couponId], references: [id])
  descricao       String?
  metaClicks      Int            @default(0)
  metaConversoes  Int            @default(0)
  dataInicio      DateTime?
  dataFim         DateTime?
  createdAt       DateTime       @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  Int?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
