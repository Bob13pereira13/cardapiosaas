DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cardapio
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
API_URL=https://api.cardapiopedeai.com.br
FRONTEND_URL=https://cardapiopedeai.com.br
CORS_ORIGINS=https://cardapiopedeai.com.br,http://cardapiopedeai.com.br,https://www.cardapiopedeai.com.br,http://www.cardapiopedeai.com.br
APP_DOMAIN=https://cardapiopedeai.com.br
ALLOW_CUSTOM_DOMAIN_ORIGINS=false
UPLOADS_DIR=./uploads
API_DOMAIN=https://api.cardapiopedeai.com.br

# Asaas — pagamento e assinaturas
# Sandbox: https://sandbox.asaas.com/ | Produção: https://www.asaas.com/
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Gere com: openssl rand -base64 32
ASAAS_WEBHOOK_TOKEN=

# SMTP para envio de e-mails (opcional em dev; usa console.log como fallback)
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua-senha-smtp
SMTP_FROM=noreply@seudominio.com

# Marketplace — AES-256-GCM key para encriptar authData
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKETPLACE_ENCRYPTION_KEY=PLACEHOLDER_GENERATE_VIA_CRYPTO_RANDOMBYTES_32
